# TAKATA — variables d'environnement (production)
# Copier en `.env` localement, ou configurer dans le tableau de bord de l'hébergeur.
NODE_ENV=production
PORT=8080

# Dossier de données : monter un DISQUE PERSISTANT ici chez l'hébergeur
# (Render : /data ; Fly : /data ; VPS : /var/lib/takata)
TAKATA_DATA_DIR=/data
TAKATA_DB=/data/takata.db

# Derrière un proxy (Render/Fly/nginx) : OBLIGATOIRE pour que le rate-limit
# de connexion voie la vraie IP du client au lieu de celle du proxy.
TRUST_PROXY=1
